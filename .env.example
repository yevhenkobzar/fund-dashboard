# Copy to .env and replace the placeholders. Never commit .env.

# SQLite file for local use (path is relative to prisma/schema.prisma).
# To deploy on Postgres, change provider in prisma/schema.prisma to "postgresql",
# point DATABASE_URL at that database, and run prisma migrate deploy.
DATABASE_URL="file:./dev.db"

# openssl rand -base64 32
# Rotating this signs everyone out and invalidates API tokens.
AUTH_SECRET="replace-with-a-long-random-string"

# Public URL Auth.js uses to build magic links.
AUTH_URL="http://127.0.0.1:4321"
AUTH_TRUST_HOST="true"

# First admin, created by the seed. No password is stored.
ADMIN_EMAIL="owner@example.com"
ADMIN_NAME="Owner"

# Shown in the desk until you set the real name.
FUND_NAME="[Fund Name]"

# console prints the magic link in the server log.
# In development it is also shown on the check-email page.
# Use resend or smtp outside local development.
# EMAIL_PROVIDER=console | resend | smtp
EMAIL_PROVIDER="console"
EMAIL_FROM="desk@example.com"

# Only when EMAIL_PROVIDER=resend
RESEND_API_KEY=""

# Only when EMAIL_PROVIDER=smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# true loads an illustrative book, team, and articles. Set false for a blank desk.
SEED_EXAMPLE_DATA="true"
