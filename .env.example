# Copy to .env and replace the placeholders. Never commit .env.

# Local Postgres from `docker compose up -d` (user and password are local-only).
# Production uses the Neon pooled URL here, and the direct URL below.
# If the pooled host contains "-pooler" and the query string has no pgbouncer flag,
# append &pgbouncer=true so Prisma does not use prepared statements on the pooler.
DATABASE_URL="postgresql://desk:desk@127.0.0.1:54329/desk?sslmode=disable"
DATABASE_URL_UNPOOLED="postgresql://desk:desk@127.0.0.1:54329/desk?sslmode=disable"

# openssl rand -base64 32
# Rotating this signs everyone out and invalidates API tokens.
AUTH_SECRET="replace-with-a-long-random-string"

# Public URL Auth.js uses to build magic links.
AUTH_URL="http://127.0.0.1:4321"
AUTH_TRUST_HOST="true"

# First admin, created by the seed. No password is stored.
ADMIN_EMAIL="owner@example.com"
ADMIN_NAME="Owner"

# Shown in the desk until you set the real name.
FUND_NAME="[Fund Name]"

# console prints the magic link in the server log.
# In development it is also shown on the check-email page.
# Production on Vercel must use resend. SMTP remains available.
# EMAIL_PROVIDER=console | resend | smtp
EMAIL_PROVIDER="console"
EMAIL_FROM="desk@example.com"

# Only when EMAIL_PROVIDER=resend. The from-address domain must be verified in Resend.
RESEND_API_KEY=""

# Only when EMAIL_PROVIDER=smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Local dev loads the illustrative book when this is unset.
# Production and any Vercel deploy stay empty unless this is true.
# Set false on Vercel so the seed creates only the ADMIN_EMAIL admin.
SEED_EXAMPLE_DATA="true"
